{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	   "logo": {
	// // "source": "~/Pictures/Wallpapers/Maris_Willem_Ducks.jpg",
	"type": "small",
	// "height": 20,
	"padding": {
	    "top": 4
	}
    },
    "display": {
	"separator": " ",
	"color": {
	    // "output": "38;2;246;244;221", // beige
	    "output": "38;2;242;186;162", // hot pink
	    "keys": "38;2;135;5;124" // magenta
	}
    },
    "modules": [
	"break",
	"break",
	{
	    "type": "custom",
	    "format": "\u001b[38;2;244;220;221m₊˚๑ ✧ \u001b[38;2;249;123;69mkavya 󰧲"
	    // "format": "₊˚๑ ✧ kavya 󰧲",
	    // "outputColor":"38;2;249;123;69"

	},
	"break",
	{
	    "type": "os",
	    "key": "  "
	},
	{
	    "type": "kernel",
	    "key": "  "
	},
	{
	    "type": "wm",
	    "key": "  ",
	    "format": "{pretty-name}"
	},

	{
	    "type": "packages",
	    "format": "{} (pacman) ", 
	    "key": "  "
	},
	{
	    "type": "shell",
	    "key": "  "
	},
	{
	    "type": "terminal",
	    "key": "  "
	},
	{
	    "type": "memory",
	    "key": " 󰍛 ",
	    "format": "{used}"

	},
	"break",
	{
	    "type": "custom",
 	    // "format": "\u001b[90m \u001b[31m \u001b[32m \u001b[33m \u001b[34m \u001b[35m \u001b[36m \u001b[37m "
 	    "format": "  \u001b[90m󰅹 \u001b[31m󰅹 \u001b[32m󰅹 \u001b[33m󰅹 \u001b[34m󰅹 \u001b[35m󰅹 \u001b[36m󰅹 \u001b[37m󰅹 "
	}
	    ]
}
