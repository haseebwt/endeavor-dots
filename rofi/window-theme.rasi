* {
    font:   "DejaVu Sans Mono 12";

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location: center;

    // y-offset: 50px; 
    width: 450px;
    height: 420px;
    border-radius: 20px;
}

mainbox {
    padding:    8 0px 0 0px;
}

inputbar {
    padding:    8px 8px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: #f7cdee;
}

entry {
   placeholder: "khwajasira <3"; 
}

textbox {
    padding:    8px 24px;
}

listview {
    columns: 1;
    margin: 10px 0 0;
    padding: 1px 0px;
}

element {
    padding:        10px 12px;
    spacing:        10px;
    border-radius:  6px;
}
element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}
