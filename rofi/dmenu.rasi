* {

    font:            "hack nerd font mono 16";
}
window {
    anchor:     north;
    location:   center;
    width:      30%;
    height: 	10%;
    padding:    6px;
    children:   [ prompt, horibox ];

    border-radius: 20px;
}
horibox {
    orientation: horizontal;
    children:   [ listview ];
}
listview {
    layout:     horizontal;
    spacing:    5px;
    lines:      2;
    padding: 4px;
}
entry {
    // enabled: false;
    expand:     false;
    width:      10em;
}

prompt {

    padding: 	10px 0 10 245px;
    
}

element {
    // margin: 22px;
    padding: 2px;
    width: 14%;
    border-radius: 10px;
    align: center;
}
element selected {
    background-color: SteelBlue;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0.5;
}

