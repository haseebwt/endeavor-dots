SELECT
  t.accountID,
  m.roomID,
  m.timestamp,
  
    m.id AS mx_msg_id,
    m.roomID AS mx_msg_roomID,
    m.eventID AS mx_msg_eventID,
    m.message AS mx_msg_msg,
    m.hsOrder AS mx_msg_hsOrder,
    m.sendStatus AS mx_msg_sendStatus,
    (
    SELECT json_object('id', linked.id, 'message', linked.message)
    FROM mx_room_messages linked
    WHERE m.inReplyToID IS NOT NULL
      AND (linked.eventID = m.inReplyToID OR linked.lastEditionID = m.inReplyToID)
    LIMIT 1
  ) AS mx_msg_linkedMessage,
    m.echo_echoID AS mx_msg_echo_echoID
  
FROM (
  SELECT m.*
  FROM mx_room_messages m
  
  WHERE m.type NOT IN ('HIDDEN', 'REACTION') AND m.isDeleted = 0
  
   
  AND m.roomID IN (?)
   
   
   
  AND (json_extract(message, '$.attachments') LIKE '%"type":"img"%' OR json_extract(message, '$.attachments') LIKE '%"type":"video"%' OR (json_extract(message, '$.attachments') LIKE '%"type":"link"%' OR json_array_length(m.message, '$.links') > 0))
   
  ORDER BY m.timestamp DESC, m.id DESC
  LIMIT 13
) m
JOIN threads t ON m.roomID = t.threadID
