    relatesToID = excluded.relatesToID,
    hsOrder = excluded.hsOrder,
    hsSuborder = excluded.hsSuborder,
    hsOrderString = excluded.hsOrderString,
    lastVisibleEventID = excluded.lastVisibleEventID
  WHERE excluded.hsOrder >= mx_read_receipts.hsOrder
  RETURNING *
  
