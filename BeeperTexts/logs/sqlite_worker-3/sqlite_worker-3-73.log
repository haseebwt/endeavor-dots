    INSERT INTO mx_read_receipts (userID, timestamp, roomID, relatesToID, hsOrder, hsSuborder, hsOrderString, lastVisibleEventID)
    VALUES (?, ?, ?, ?, ?, ?, ?, COALESCE((
  SELECT eventID
  FROM mx_room_messages
  WHERE
    roomID = ? AND
    type != 'HIDDEN' AND
    type != 'REACTION' AND
    hsOrder <= ?
  ORDER BY hsOrder DESC LIMIT 1
), ?))
  ON CONFLICT(roomID, userID) DO UPDATE SET
    timestamp = excluded.timestamp,
    relatesToID = excluded.relatesToID,
    hsOrder = excluded.hsOrder,
    hsSuborder = excluded.hsSuborder,
    hsOrderString = excluded.hsOrderString,
    lastVisibleEventID = excluded.lastVisibleEventID
  WHERE excluded.hsOrder >= mx_read_receipts.hsOrder
