    VALUES (?, ?, ?, ?, ?, ?, ?, COALESCE((
  SELECT eventID
  FROM mx_room_messages
  WHERE
    roomID = ? AND
    type != 'HIDDEN' AND
    type != 'REACTION' AND
    hsOrder <= ?
  ORDER BY hsOrder DESC LIMIT 1
), ?))
  ON CONFLICT(roomID, userID) DO UPDATE SET
    timestamp = excluded.timestamp,
    relatesToID = excluded.relatesToID,
