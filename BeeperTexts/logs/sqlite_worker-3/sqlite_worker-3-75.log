) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(roomID, eventID) DO UPDATE SET
  senderContactID = excluded.senderContactID,
  timestamp = excluded.timestamp,
  isEdited = excluded.isEdited,
  lastEditionID = excluded.lastEditionID,
  isDetached = excluded.isDetached,
  lastEditionTimestamp = excluded.lastEditionTimestamp,
  lastEditionOrder = excluded.lastEditionOrder,
