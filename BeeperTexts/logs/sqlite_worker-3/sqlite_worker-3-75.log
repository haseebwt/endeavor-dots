[debug] [2026-04-17T20:27:09.523Z] [sqlite-worker] 
  SELECT
    t.rowid AS localChatID,
    t.accountID,
    t.threadID,
    t.thread,
    t.timestamp,
    
    m.id AS mx_msg_id,
    m.roomID AS mx_msg_roomID,
    m.eventID AS mx_msg_eventID,
    m.message AS mx_msg_msg,
    m.hsOrder AS mx_msg_hsOrder,
    m.sendStatus AS mx_msg_sendStatus,
    m.seenByMeAt AS mx_msg_seenByMeAt,
    (
        SELECT json_group_object(rr.userID, rr.timestamp)
        FROM mx_read_receipts rr
        WHERE rr.roomID = m.roomID
          AND rr.lastVisibleEventID = m.eventID
        GROUP BY rr.lastVisibleEventID
    ) AS mx_msg_readReceipts,
    (
        SELECT json_group_array(json(r.reaction))
        FROM mx_reactions r
        WHERE r.roomID = m.roomID
          AND r.eventID = m.eventID
          AND r.isDeleted = 0
        ORDER BY r.timestamp DESC
    ) AS mx_msg_reactions,
    (
    SELECT json_object('id', linked.id, 'message', linked.message)
    FROM mx_room_messages linked
    WHERE m.inReplyToID IS NOT NULL
      AND (linked.eventID = m.inReplyToID OR linked.lastEditionID = m.inReplyToID)
    LIMIT 1
  ) AS mx_msg_linkedMessage,
    (
    SELECT json_extract(value, '$.user_id') FROM key_values WHERE key = 'beeperState'
  ) AS current_user_id,
    m.echo_echoID AS mx_msg_echo_echoID
  ,
    (
      SELECT json_group_array(
        json_object(
          'account_id', p.account_id,
          'participant_id', p.id,
          'room_id', p.room_id,
          'full_name', p.full_name,
          'nickname', p.nickname,
          'img_url', p.img_url,
          'is_verified', p.is_verified,
          'cannot_message', p.cannot_message,
          'is_self', p.is_self,
          'is_network_bot', p.is_network_bot,
          'added_by', p.added_by,
          'is_admin', p.is_admin,
          'is_pending', p.is_pending,
          'has_exited', p.has_exited,
          'identifiers', (
            SELECT json_group_array(
              json_object(
                'identifier', pi.identifier,
                'identifier_type', pi.identifier_type
              )
            )
            FROM participant_identifiers pi
            WHERE pi.account_id = p.account_id AND pi.participant_id = p.id
          )
        )
      )
      FROM participants p
      WHERE p.room_id = t.threadID AND p.account_id = t.accountID
    ) AS participants_json
  FROM (
    SELECT rowid, threadID, thread, timestamp, accountID
    FROM threads
    WHERE accountID IN (?)
      AND json_extract(thread, '$.extra.roomType') IS NOT 'm.space'
      
    ORDER BY timestamp DESC
    LIMIT 100
  ) t
  LEFT JOIN mx_room_messages m ON m.id = json_extract(t.thread, '$.partialLastMessage.id')
  ORDER BY t.timestamp DESC

