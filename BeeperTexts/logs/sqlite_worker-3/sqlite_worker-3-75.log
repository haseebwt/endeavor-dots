  isEncrypted,
  inReplyToID,
  isReplyThreadFallback,
  type,
  hsOrder,
  isSentByMe,
  replyCount,
  shouldNotify,
  shouldPreview,
  countsAsUnread,
  lastDeletionID,
  editedType,
  message,
  echo_echoID,
  seenByMeAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(roomID, eventID) DO UPDATE SET
  senderContactID = excluded.senderContactID,
  timestamp = excluded.timestamp,
  isEdited = excluded.isEdited,
  lastEditionID = excluded.lastEditionID,
  isDetached = excluded.isDetached,
  lastEditionTimestamp = excluded.lastEditionTimestamp,
  lastEditionOrder = excluded.lastEditionOrder,
  isDeleted = excluded.isDeleted,
  isEncrypted = excluded.isEncrypted,
  inReplyToID = excluded.inReplyToID,
  isReplyThreadFallback = excluded.isReplyThreadFallback,
  type = excluded.type,
  hsOrder = excluded.hsOrder,
  isSentByMe = excluded.isSentByMe,
  replyCount = excluded.replyCount,
  shouldNotify = excluded.shouldNotify,
  shouldPreview = excluded.shouldPreview,
  countsAsUnread = excluded.countsAsUnread,
  lastDeletionID = excluded.lastDeletionID,
  editedType = excluded.editedType,
  message = excluded.message,
  echo_echoID = excluded.echo_echoID,
  seenByMeAt = excluded.seenByMeAt,
  sendStatus = NULL RETURNING 
    mx_room_messages.id AS mx_msg_id,
    mx_room_messages.roomID AS mx_msg_roomID,
    mx_room_messages.eventID AS mx_msg_eventID,
    mx_room_messages.message AS mx_msg_msg,
    mx_room_messages.hsOrder AS mx_msg_hsOrder,
    mx_room_messages.sendStatus AS mx_msg_sendStatus,
    (
    SELECT json_object('id', linked.id, 'message', linked.message)
    FROM mx_room_messages linked
    WHERE mx_room_messages.inReplyToID IS NOT NULL
      AND (linked.eventID = mx_room_messages.inReplyToID OR linked.lastEditionID = mx_room_messages.inReplyToID)
    LIMIT 1
  ) AS mx_msg_linkedMessage,
    mx_room_messages.echo_echoID AS mx_msg_echo_echoID
  
