          AND r.eventID = m.eventID
          AND r.isDeleted = 0
        ORDER BY r.timestamp DESC
    ) AS mx_msg_reactions,
    (
    SELECT json_object('id', linked.id, 'message', linked.message)
    FROM mx_room_messages linked
    WHERE m.inReplyToID IS NOT NULL
      AND (linked.eventID = m.inReplyToID OR linked.lastEditionID = m.inReplyToID)
    LIMIT 1
  ) AS mx_msg_linkedMessage,
    (
    SELECT json_extract(value, '$.user_id') FROM key_values WHERE key = 'beeperState'
  ) AS current_user_id,
    m.echo_echoID AS mx_msg_echo_echoID
  
