SELECT
  t.accountID,
  t.thread,
  (
    SELECT json_group_array(
      json_object(
        'account_id', p.account_id,
        'participant_id', p.id,
        'room_id', p.room_id,
        'full_name', p.full_name,
        'nickname', p.nickname,
        'img_url', p.img_url,
        'is_verified', p.is_verified,
        'cannot_message', p.cannot_message,
        'is_self', p.is_self,
        'is_network_bot', p.is_network_bot,
        'added_by', p.added_by,
        'is_admin', p.is_admin,
        'is_pending', p.is_pending,
        'has_exited', p.has_exited,
        'identifiers', (
          SELECT json_group_array(
            json_object(
              'identifier', pi.identifier,
              'identifier_type', pi.identifier_type
            )
          )
          FROM participant_identifiers pi
          WHERE pi.account_id = p.account_id AND pi.participant_id = p.id
        )
      )
    )
    FROM participants p
    WHERE p.room_id = t.threadID AND p.account_id = t.accountID
  ) AS participants_json
FROM threads t
WHERE t.threadID = ?

